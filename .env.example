# Built-in storage adapter.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://chopin:chopin@127.0.0.1:5432/chopin?sslmode=disable

# Hosted planner defaults.
AGENT=on
MODEL=claude-sonnet-4.6
BACKGROUND_JOBS=on
WEB_RESEARCH=on

# The Anthropic-Messages-API-compatible gateway the planner calls.
# Required whenever AGENT=on.
LITELLM_BASE_URL=https://llm-gateway.razorpay.com
LITELLM_API_KEY=

# Razorpay Agent Platform ("slash") — optional.
# Enables the planner's ask_clash tool, which runs questions against Clash,
# this deployment's agent on the platform. The key is a service-account API
# key (ak_live_…) minted in the platform website's account settings; the base
# URL and key must be set together, and an empty key disables the integration.
AGENT_PLATFORM_BASE_URL=
AGENT_PLATFORM_KEY=
CLASH_AGENT_NAME=slash

# GitHub App sign-in.
# Remote VM mode overrides this local origin in child processes; see docs/exe-dev.md.
APP_ORIGIN=http://127.0.0.1:8787
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional comma-separated GitHub logins. The lists are combined; leave both
# empty to admit every authenticated GitHub user.
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ORGANIZATIONS=
# Encrypts only the short-lived OAuth state and PKCE cookie.
# Generate it with `openssl rand -hex 32`.
SESSION_ENCRYPTION_KEY=
